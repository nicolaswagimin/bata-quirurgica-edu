# Copy to services/api/.env for local scripts (dev-server, seed, set-admin, ingest-kb).
# Loaded by `node --env-file-if-exists=.env` in every package.json script.
STAGE=dev
WEB_ORIGIN=http://localhost:5173
FIREBASE_PROJECT_ID=demo-bata
GCLOUD_PROJECT=demo-bata
# Local emulators (leave set for local work; remove only for real-project scripts)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
SHOW_DRAFT_QUESTIONS=true
# Groq (step 14). Local only; deployed Lambdas read GROQ_SECRET_ID from Secrets Manager.
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo
# Knowledge base (step 13). Cosine distance threshold; above it a fragment is discarded.
KB_MAX_DISTANCE=0.35
# Bedrock embeddings for ingest-kb (uses your AWS CLI credentials)
AWS_REGION=us-east-1
# Real-project scripts only (set-admin/ingest against prod): path to a service-account JSON file
GOOGLE_APPLICATION_CREDENTIALS=
