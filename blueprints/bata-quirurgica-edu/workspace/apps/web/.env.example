# Copy to apps/web/.env.development.local (dev) or set in CI for production builds.
# Firebase console > Project settings > General > Your apps > Web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# true = connect to local emulators (auth 9099, firestore 8080)
VITE_USE_EMULATORS=true
# Local: http://127.0.0.1:3001/v1 · Prod: ApiStack output ApiUrl (ends in /v1)
VITE_API_BASE_URL=http://127.0.0.1:3001/v1
# Datadog RUM (step 17). Empty token = RUM disabled.
VITE_DD_CLIENT_TOKEN=
VITE_DD_APPLICATION_ID=
VITE_DD_SITE=datadoghq.com
VITE_DD_ENV=dev
VITE_APP_VERSION=0.1.0
