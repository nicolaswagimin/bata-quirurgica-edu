# Committed on purpose: public demo values for the Firebase emulators (project id demo-bata).
# Firebase web config is not secret. Used by `vite build --mode e2e`.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-bata.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-bata
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_USE_EMULATORS=true
VITE_API_BASE_URL=http://127.0.0.1:3001/v1
VITE_DD_CLIENT_TOKEN=
VITE_DD_APPLICATION_ID=
VITE_DD_SITE=datadoghq.com
VITE_DD_ENV=e2e
VITE_APP_VERSION=0.1.0
