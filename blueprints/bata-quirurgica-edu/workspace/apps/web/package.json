{
  "name": "@bata/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test --grep-invert @emu",
    "test:e2e:emu": "pnpm --filter @bata/api run seed && E2E_WITH_API=1 playwright test --grep @emu",
    "mediapipe:prepare": "node --import tsx scripts/prepare-mediapipe.ts"
  },
  "dependencies": {
    "@bata/shared": "workspace:*",
    "@datadog/browser-logs": "7.15.0",
    "@datadog/browser-rum": "7.15.0",
    "@google/model-viewer": "4.3.1",
    "@mediapipe/tasks-vision": "1.0.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "firebase": "12.19.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
