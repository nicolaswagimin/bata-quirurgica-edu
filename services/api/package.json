{
  "name": "@bata/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:emu": "vitest run --config vitest.emu.config.ts",
    "dev": "node --env-file-if-exists=.env --import tsx scripts/dev-server.ts",
    "dev:smoke": "node --env-file-if-exists=.env --import tsx scripts/dev-server.ts --smoke",
    "seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "set-admin": "node --env-file-if-exists=.env --import tsx scripts/set-admin.ts",
    "ingest-kb": "node --env-file-if-exists=.env --import tsx scripts/ingest-kb.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1146.0",
    "@aws-sdk/client-secrets-manager": "3.1146.0",
    "@bata/shared": "workspace:*",
    "datadog-lambda-js": "12.143.0",
    "firebase-admin": "14.5.0",
    "groq-sdk": "1.6.0",
    "unpdf": "1.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "24.19.1",
    "firebase": "12.19.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
