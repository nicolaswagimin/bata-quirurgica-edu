# Dependencies and build output
node_modules/
dist/
cdk.out/
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# Environment files: real values never committed
.env
.env.*
!.env.example
!apps/web/.env.e2e

# Credentials and local agent overrides
*service-account*.json
.claude/settings.local.json

# Firebase emulator and CLI artifacts
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log

# Downloaded/derived binaries (regenerated by scripts)
apps/web/public/mediapipe/
content/kb/pdfs/

# OS / editor noise
.DS_Store
*.log

# Python bytecode from the asset and vision tooling
__pycache__/

# AR v2 landmark captures (privacy: they stay on the machine that recorded them)
tools/vision/data/*
!tools/vision/data/.gitkeep

# Blender profile and intermediate renders of the 3D asset pipeline
tools/bata-3d/.work/

# Impeccable design tooling: only the shared config and the home surface contract are versioned
.impeccable/*
!.impeccable/config.json
apps/web/.impeccable/*
!apps/web/.impeccable/surfaces/
apps/web/.impeccable/surfaces/*
!apps/web/.impeccable/surfaces/src-routes-home-tsx.md
